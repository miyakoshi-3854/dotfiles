[include]
    path = ~/.config/git/config.local
[pull]
    ff = only
    rebase = false
[core]
    eol = lf
    ignorecase = false
    quotepath = false
[init]
    defaultBranch = main
[fetch]
    prune = true
[rebase]
    autosquash = true
[alias]
    m = merge
    pl = pull
    ps = push
    sl = stash list
    sp = stash pop
    ss = stash push --staged -m
    s = status -sb
    d = diff
    dc = diff --cached
    c = commit
    cm = commit -m
    ca = commit --amend
    l = log --oneline --graph --decorate
    undo = reset --soft HEAD^
[ghq]
    root = ~/ghq